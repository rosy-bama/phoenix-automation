{
  "$comment": "Read by the Ejara Automation Tool (spec §6.9.5). Edit by hand; test-plan/ is generated by the tool.",
  "app": "Phoenix",
  "framework": "playwright",
  "platforms": ["web"],
  "planDir": "test-plan",
  "tests": "tests",
  "commands": {
    "tag": "npx playwright test --grep {tag}",
    "all": "npx playwright test",
    "unit": "npm run test:unit",
    "typecheck": "npm run typecheck"
  },
  "applyPlan": "npm run plan:apply -- {bundle} --write"
}
