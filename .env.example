# Copy to .env and fill in. .env is gitignored - NEVER commit real credentials
# (the GitHub repo may be public).

PHX_BASE_URL=https://phoenix-testbox.ejaraapis.xyz
PHX_USERNAME=
PHX_PASSWORD=

# Testbox accepts any 6 digits. Production needs a fixed test OTP from dev -
# until then, never point this suite at production.
PHX_OTP=123456
PHX_ENV=testbox

# Customer account used as known test data in Fiat Wallet (username without @).
# Needs at least one cash_in and one transfer transaction in its history.
PHX_WALLET_USERNAME=rosetestbox

# Savings Box customer used for manual-operation tests.
PHX_SAVINGS_USERNAME=priscatest5

# Manual deposits/withdrawals move (test) money. Off by default.
# Set to true only on testbox, and only if the test accounts can absorb it.
PHX_ALLOW_MONEY_OPS=false

# Optional test data for the Fiat Wallet plan (cases are "Skipped" without it).
# Full name of a wallet test account (TC-WALLIST-005: search by full name).
PHX_WALLET_FULLNAME=
# Admin account WITHOUT manual-operation permission (TC-MANDEP-019, TC-MANWD-022).
PHX_LIMITED_USERNAME=
PHX_LIMITED_PASSWORD=

# Fiat Wallet report: after a complete `npm run test:fiat:report`, the report is
# published as a sub-page of ClickUp "Phoenix > Test sessions > Automatic".
# Personal API token (ClickUp > Settings > Apps). Leave empty to only write
# reports/fiat-wallet/<date>.md locally. PHX_PUBLISH_REPORT=false also turns it off.
CLICKUP_API_TOKEN=
PHX_PUBLISH_REPORT=true

# --- User Management (tests/user-management, npm run test:users:report) ---
# Confirmed, KYC-verified account used for read-only checks (default rosetestbox).
PHX_UM_USERNAME=
# Accounts in each KYC state (cases are Skipped without them).
PHX_UM_KYC_UNVERIFIED_USERNAME=
PHX_UM_KYC_PENDING_USERNAME=
PHX_UM_KYC_REJECTED_USERNAME=
# Account-changing cases (freeze, delete, deactivate/activate, MFA, contact
# details, payment methods) only run with this flag AND a DISPOSABLE account
# per flow. Testbox only.
PHX_ALLOW_ACCOUNT_OPS=false
PHX_UM_TARGET_USERNAME=     # deactivated, then re-activated
PHX_UM_FREEZE_USERNAME=     # frozen (no unfreeze flow designed yet)
PHX_UM_DELETE_USERNAME=     # deleted - irreversible
PHX_UM_MFA_USERNAME=        # has MFA methods switched on
PHX_UM_CONTACT_USERNAME=    # email / phone updated
PHX_UM_PM_USERNAME=         # payment method added / deactivated
PHX_UM_CUSTOMER_OTP=        # code the customer receives (fixed code on testbox, if any)
